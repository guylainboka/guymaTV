// guymaTV Prisma schema
// Persists favorites and downloads for the streaming wrapper app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id           String   @id // equals to french-stream newsid
  title        String
  platform     String   @default("French-Stream")
  imageUrl     String?
  quality      String?
  category     String?
  sourceUrl    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Download {
  id            String   @id @default(cuid())
  streamItemId  String
  title         String
  platform      String   @default("French-Stream")
  imageUrl      String?
  quality       String?
  progress      Int      @default(0)
  status        String   @default("downloading") // downloading | completed | paused
  sizeMB        Int      @default(0)
  downloadedMB  Int      @default(0)
  speed         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([streamItemId])
  @@index([createdAt])
}

model Comment {
  id           String   @id @default(cuid())
  streamItemId String   // french-stream newsid
  userName     String   @default("Anonyme")
  rating       Int      @default(0) // 0-5 stars
  content      String
  parentId     String?  // for replies (null = top-level comment)
  createdAt    DateTime @default(now())

  @@index([streamItemId, createdAt])
  @@index([parentId])
}
